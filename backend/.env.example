# Docker Compose (backend/docker-compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legend
POSTGRES_PORT=5432
API_PORT=8000

# Uruchamianie lokalne przez uv (uv run --env-file .env ...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legend

# voice-service (opcjonalnie, dla /api/voice/*). Klucz: w voice-service `uv run python genkey.py create backend`.
# W Dockerze API łączy się z hostem przez host.docker.internal (docker-compose.yaml).
VOICE_SERVICE_URL=http://localhost:8001
VOICE_API_KEY=
